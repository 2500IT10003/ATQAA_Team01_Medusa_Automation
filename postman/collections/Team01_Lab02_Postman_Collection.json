    {
      "name": "02_Admin_Authentication",
      "item": [
        {
          "name": "Admin Login Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function(){",
                  "    pm.response.to.have.status(200)",
                  "});",
                  "pm.test('SLA < 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"apiToken\", jsonData.token || pm.response.headers.get(\"Set-Cookie\"));",
                  "",
                  "pm.test(\"Tier 2: token is a non-null string with JWT format\", function () {",
                  "   const token = pm.environment.get(\"apiToken\");",
                  "   pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "   pm.expect(token.split(\".\")).to.have.length(3);",
                  "});",
                  "// ===== TIER 3 =====",
                  "const authSchema = { type: \"object\", required: [\"token\"],",
                  "   properties: { token: { type: \"string\", minLength: 20 } } };",
                  "pm.test('Schema Valid', function()",
                  "{pm.response.to.have.jsonSchema(authSchema); });"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n\"email\": \"student@vanlangsaigon.edu.vn\",\n\"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{adminBaseUrl}}/auth/user/emailpass",
              "host": [
                "{{adminBaseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "emailpass"
              ]
            }
          },
          "response": []
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{apiToken}}",
            "type": "string"
          }
        ]
      }

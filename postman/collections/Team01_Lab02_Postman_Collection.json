                  "         total: { type: \"number\" },",
                  "         items: { type: \"array\", items: { type: \"object\",",
                  "            required: [\"id\", \"variant_id\", \"quantity\", \"unit_price\"],",
                  "            properties: { id: { type: \"string\" }, variant_id: { type: \"string\" },",
                  "               quantity: { type: \"integer\", minimum: 1 }, unit_price: { type: \"number\" } } } }",
                  "      } } }",
                  "};",
                  "pm.test('Schema Valid', function()",
                  "{pm.response.to.have.jsonSchema(cartSchema); });"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }

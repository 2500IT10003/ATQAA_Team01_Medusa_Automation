        {
          "name": "Initialize Payment Session",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");\nconst cartId = pm.environment.get(\"cartId\");\nconst apiKey = pm.variables.get(\"publishable_api_key\");\n\n// Step 1: Automatically fetch cart details to get the region_id\npm.sendRequest({\n    url: baseUrl + \"/carts/\" + cartId,\n    method: \"GET\",\n    header: {\n        \"x-publishable-api-key\": apiKey\n    }\n}, function (err, cartRes) {\n    if (!err && cartRes.code === 200) {\n        let cart = cartRes.json().cart;\n        let regionId = cart.region_id;\n        console.log(\"Automatically found regionId: \" + regionId);\n        \n        // Step 2: Fetch payment providers using the extracted region_id\n        pm.sendRequest({ \n            url: baseUrl + \"/payment-providers?region_id=\" + regionId, \n            method: \"GET\",\n            header: {\n                \"x-publishable-api-key\": apiKey\n            }\n        }, function (err, providerRes) { \n            if (!err && providerRes.code === 200) { \n                let providers = providerRes.json().payment_providers; \n                if (providers && providers.length > 0) { \n                    pm.environment.set(\"providerId\", providers[0].id); \n                    console.log(\"Successfully set providerId: \" + providers[0].id);\n                } else {\n                    console.error(\"No payment providers available for this region.\");\n                } \n            } else {\n                console.error(\"Failed to fetch payment providers\", err || providerRes.json());\n            } \n        });\n\n        // Step 3: Automatically create Payment Collection and save its ID\n        pm.sendRequest({\n            url: baseUrl + \"/payment-collections\",\n            method: \"POST\",\n            header: {\n                \"x-publishable-api-key\": apiKey,\n                \"Content-Type\": \"application/json\"\n            },\n            body: {\n                mode: \"raw\",\n                raw: JSON.stringify({ cart_id: cartId })\n            }\n        }, function (err, pcRes) {\n            if (!err && (pcRes.code === 200 || pcRes.code === 201)) {\n                let pcId = pcRes.json().payment_collection.id;\n                pm.environment.set(\"paymentCollectionId\", pcId);\n                console.log(\"Successfully set paymentCollectionId: \" + pcId);\n            } else {\n                console.error(\"Failed to create payment collection\", err || pcRes.json());\n            }\n        });\n\n    } else {\n        console.error(\"Failed to fetch cart details\", err || cartRes.json());\n    }\n});"
                ]
              }
            }
          ],

        {
          "name": "Get Products List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function(){",
                  "    pm.response.to.have.status(200)",
                  "});",
                  "pm.test('SLA < 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "const productsSchema = {",
                  "   type: \"object\", required: [\"products\"],",
                  "   properties: { products: { type: \"array\", minItems: 1, items: {",
                  "      type: \"object\", required: [\"id\", \"title\", \"variants\"],",
                  "      properties: { id: { type: \"string\" }, title: { type: \"string\" },",
                  "         variants: { type: \"array\", minItems: 1, items: { type: \"object\", required: [\"id\"], properties: { id: { type: \"string\" } } } } }",
                  "   } } }",
                  "};",
                  "pm.test('Schema Valid', function()",
                  "{pm.response.to.have.jsonSchema(productsSchema); });",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
